# StockFlow Frontend - ambiente LOCAL
REACT_APP_API_URL=http://localhost:3000/api
PORT=5173

# Login não vem mais preenchido automaticamente.
# Não use credenciais padrão no frontend.

# Sessao: encerra ao fechar a pagina/app. Como protecao adicional,
# encerra apos 8 horas sem atividade (480 minutos).
REACT_APP_SESSION_IDLE_MINUTES=480
